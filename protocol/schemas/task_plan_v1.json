{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudpilot.local/schemas/task_plan_v1.json",
  "title": "CloudPilotTaskPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "task_id",
    "plan_version",
    "workspace_id",
    "goal",
    "success_conditions",
    "idempotency_key",
    "retry_bounds",
    "approvals",
    "verification_requirements",
    "steps"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "goal": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 6,
      "maxLength": 256
    },
    "retry_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "timeout_seconds"],
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 300.0
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_user_approval", "approved", "allow_overwrite"],
      "properties": {
        "requires_user_approval": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "allow_overwrite": {
          "type": "boolean"
        },
        "approved_by": {
          "type": ["string", "null"]
        },
        "approved_at": {
          "type": ["string", "null"]
        }
      }
    },
    "verification_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify_checksums", "require_manifest"],
      "properties": {
        "verify_checksums": {
          "type": "boolean"
        },
        "require_manifest": {
          "type": "boolean"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "args", "depends_on"],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "action": {
            "type": "string",
            "enum": [
              "list_files",
              "get_file_info",
              "create_folder",
              "copy_file",
              "verify_file",
              "generate_manifest"
            ]
          },
          "args": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^s[0-9]+$"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
