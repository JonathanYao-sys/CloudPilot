{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudpilot.local/schemas/tool_call_v1.json",
  "title": "CloudPilotToolCallV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "args"],
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "list_files",
        "get_file_info",
        "create_folder",
        "copy_file",
        "verify_file",
        "generate_manifest",
        "abstain",
        "report_error"
      ]
    },
    "args": {
      "type": "object"
    },
    "step_id": {
      "type": "string"
    }
  }
}
